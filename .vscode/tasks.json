{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wasm: build core",
      "type": "shell",
      "command": "wasm-pack build --target web --out-dir pkg --no-default-features --features console_error_panic_hook",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "wasm: build full",
      "type": "shell",
      "command": "wasm-pack build --target web --out-dir pkg-full",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "wasm: build all",
      "dependsOn": ["wasm: build core", "wasm: build full"],
      "dependsOrder": "sequence",
     
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
